{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "pillar": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "draft",
        "scheduled",
        "published"
      ],
      "default": "draft"
    },
    "scheduled_date": {
      "type": "string"
    },
    "published_date": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "shares": {
      "type": "number",
      "default": 0
    },
    "saves": {
      "type": "number",
      "default": 0
    },
    "youtube_plan": {
      "type": "object"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}