# Supabase project (Settings > API). The anon key is safe in the browser; row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Google OAuth client ID (Web application) for "Connect YouTube account". Public value.
VITE_GOOGLE_CLIENT_ID=
